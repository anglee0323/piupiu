# 开发 / 自己用：复制成项目根目录的 .env。
# 安装版（PIUPIU_APP=1）不读这里，只读用户目录里的 .env（macOS ~/Library/Application Support/Piupiu/.env，Windows %APPDATA%\Piupiu\.env），一般不需要。
# 复制成 .env 后按需修改。程序启动时会自动读取项目根目录的 .env（已经在环境变量里的不覆盖）

# sim = 模拟盘；live = 实盘行情
MODE=sim
PORT=8787

# 1 = 实盘真实下单（只接受页面上手动点击的订单）；0 = 只报价 / 预演
LIVE_TRADE=0

# 单笔买入上限（BNB），0 = 不限；页面里改过后以 data/live-settings.json 为准
MAX_TRADE_BNB=0.5

# 自动转出的目标地址（领取后 / 发射后自动把代币转到这里）。务必填你自己的地址；不用自动转出就留空
AUTO_TRANSFER_TO=
# 旧开关：1 = Four 发射后自动转出（一般用页面上的开关即可）
AUTO_TRANSFER_FOUR=0

# 旧功能：买入后无限额预授权，不建议打开
PREAPPROVE=0

# 私有节点（可选，推荐）：例如 NodeReal 的 https://bsc-mainnet.nodereal.io/v1/<你的key>。填了就作为主节点（读链、查确认、扫 Four 事件，一次可查约 5 万块），
# 公共节点自动做备用。key 只放 .env，不要写进代码或提交
NODEREAL_RPC=
# 也可以填多个 NodeReal key（逗号分隔，只填 key 本身），会轮流使用；某个被限流 / 额度用完时自动换下一个，都不可用时用公共节点
NODEREAL_KEYS=
# NodeReal 免费版每月只有 1000 万 CU（平均每秒 3.8 CU），后台常驻的行情 / 订阅一个月都用不完。默认 NodeReal 只给「下单」用；付费版额度充足时才改成 all
# NODEREAL_SCOPE=trade
# 本月累计用量达到这个 CU 数就停用 NodeReal、改用公共节点，下月 1 号（UTC）自动恢复；0 = 不限制。默认留 10% 余量
# NODEREAL_MONTHLY_CU=9000000

# 读链 RPC（不填 = 有 NODEREAL_RPC 用它，否则 bsc-dataseed）；扫 Four 事件用的 RPC；启动时回扫的区块数
RPC_URL=
FOUR_LOG_RPC=
FOUR_BACKFILL_BLOCKS=150000

# 币安 Agentic Wallet CLI
BAW_BIN=baw
BINANCE_CHAIN_ID=56
BAW_SLIPPAGE_UNIT=percent
WALLET_LABEL=币安 Agentic 钱包

# Four 专属模板的技能脚本路径（留空会自动在 .agents/ 和 ~/.claude/skills/ 里找）
OPENFOUR_SCRIPT=

# 其他可选项（一般不用改）
# 解析 .ai 域名用的 RPC，逗号分隔
NAME_RPC=
# 模拟 / 测试网用的 BSC 测试网 RPC
BSC_TESTNET_RPC=
# scripts/watch-four.js：WebSocket 节点、four.meme TokenManager 合约地址
BSC_WSS=
FOUR_MANAGER=

# 本地 API 防护
# 改动类接口（下单、设置、转出规则等）只接受本页面（同源）或带 x-tmtn-token 的请求。
# 留空会在 data/api-token 里随机生成
TMTN_API_TOKEN=
# 额外允许的主机名 / 页面来源（逗号分隔，一般不用填）
ALLOWED_HOSTS=
ALLOWED_ORIGINS=
# 代币头像代理额外允许的图床域名（逗号分隔；默认只允许 four.meme / pinata / gang.fun / IPFS 网关等）
IMG_HOSTS=

# 钱包命令行使用的代理（默认跟随系统代理；只支持 HTTP / HTTPS 代理）。off = 强制直连；也可以写 http://127.0.0.1:7890
# PIUPIU_PROXY=

# 机会雷达「推特上怎么说」（可选）：CrawlerHub Twitter API 的 key（https://api.crawlerhub.org）。不填就只显示「在 X 上搜」的跳转链接
# CRAWLERHUB_API_KEY=

# ---------------------------------------------------------------------------
# 数据源（开源版不内置任何地址，按需填写；说明见 docs/self-hosting.md「数据源」）
# 节点：RPC_URL 必填（读链、下单确认）；RPC_PUBLIC 逗号分隔的备用节点；RPC_LOGS 支持大范围 eth_getLogs 的节点；WSS_URL 订阅
RPC_PUBLIC=
RPC_LOGS=
WSS_URL=
DEXSCREENER_API=
GECKOTERMINAL_API=
BINANCE_API=
BINANCE_WEB3_API=
GANG_API=
SHRINE_API=
SHRINE_WS=
FSI_API=
FOUR_STATIC=
IPFS_GATEWAYS=
ARWEAVE_GATEWAY=
OPENCHAIN_API=
FOURBYTE_API=
SOURCIFY_API=
TRANSLATE_API=
SPACEID_API=
X_SEARCH_API=
FXTWITTER_API=
